APP_NAME=AgriAI Backend
APP_VERSION=1.0.0
ENVIRONMENT=local

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agri_ai

# SQLite fallback for immediate local development:
DATABASE_URL=sqlite:///./agri_ai.db

SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
STORAGE_DIR=storage
CORS_ORIGINS=*
